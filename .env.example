# 全局开启轻互动；关闭后词典仍可使用
TAOZI_FUN_ENABLED=true

# 同一用户、同一互动指令的冷却秒数
TAOZI_FUN_COOLDOWN_SECONDS=8

# 词典回复是否显示 B 站来源链接
TAOZI_LEXICON_SHOW_SOURCES=true

# “今日桃签”日期所属时区
TAOZI_TIMEZONE=Asia/Shanghai

# 默认将词典和互动回复渲染成 PNG 图片
TAOZI_IMAGE_ENABLED=true

# 图片生成失败时回退为原纯文本回复
TAOZI_IMAGE_FALLBACK_TEXT=true

# 可选：中文字体文件路径，多个路径使用分号分隔；留空自动探测
TAOZI_FONT=
